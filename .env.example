# Copia este archivo a .env (nunca subas el .env real al repositorio).
# Cada variable corresponde a la tabla de la guía (§3 y §12.1).

# --- Entorno -------------------------------------------------------------------------------------
# local | test | prod. En prod: Cognito y bucket obligatorios, sin AWS_ENDPOINT_URL, sin /docs.
APP_ENV=local
# simulada | real. Hasta la Fase C (WhatsApp e IA reales) se queda en simulada.
INTEGRACION_WHATSAPP=simulada
INTEGRACION_IA=simulada
LOG_LEVEL=INFO

# --- Base de datos ---------------------------------------------------------------------------------
# Opción 1 (local): URL completa. Si está definida, tiene prioridad sobre las piezas.
DATABASE_URL=postgresql+psycopg://anuc:anuc_local@localhost:5432/anuc_db
# Opción 2 (AWS): piezas. En ECS, DB_USER y DB_PASSWORD llegan desde Secrets Manager.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=anuc_db
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require        # con el Postgres del docker-compose: disable
# Dimensión de los embeddings. Cambiarla obliga a recalcular todos los vectores.
EMBEDDING_DIM=1024

# --- AWS -------------------------------------------------------------------------------------------
AWS_REGION=us-east-1
# Solo para LocalStack. En AWS se deja vacío y boto3 usa el rol IAM de la tarea ECS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/mensajes-entrantes.fifo
S3_BUCKET_EVIDENCIAS=

# --- Autenticación (Cognito) -----------------------------------------------------------------------
# Vacías en local: la API valida tokens firmados con una clave de pruebas (python -m app.core.tokens_prueba).
# Con el User Pool definido, local y prod validan contra el JWKS real.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=
# Dónde guarda `local` su clave de pruebas (fuera del repositorio).
JWT_PRUEBA_KEY_PATH=.local/jwt_prueba.pem

# --- CORS ------------------------------------------------------------------------------------------
# Orígenes separados por comas, sin '*'. Vacío si el panel y la API comparten origen (CloudFront).
CORS_ORIGINS=http://localhost:5173

# --- WhatsApp --------------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=token-local
WHATSAPP_APP_SECRET=secreto-local
# Solo con INTEGRACION_WHATSAPP=real
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
