# Copia este archivo a .env (nunca subas el .env real al repositorio).
AWS_REGION=us-east-1
# Solo para LocalStack. En AWS se deja vacío y boto3 usa el rol IAM de la tarea ECS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/mensajes-entrantes.fifo
WHATSAPP_VERIFY_TOKEN=token-local
WHATSAPP_APP_SECRET=secreto-local
LOG_LEVEL=INFO
